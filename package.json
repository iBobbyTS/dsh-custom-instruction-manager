{
  "name": "dsh-skill-hub",
  "version": "0.3.26",
  "description": "GUI manager for DeepSeek Harness AGENTS.md instructions and the full skill catalog: edit instruction files, inspect skills, install from the market, and count tokens.",
  "icon": "./icon.svg",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-cordis",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "guided",
      "adapter": "third-party",
      "failurePolicy": "manual",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "hot-reload",
      "dispose": "supported"
    },
    "permissions": [
      "fs:read",
      "fs:write",
      "net:https",
      "net:loopback"
    ],
    "compatibility": {
      "dshVersions": [
        "0.1.7-alpha.1",
        "0.1.7-alpha.2",
        "0.1.7-rc.1",
        "0.1.7-rc.2",
        "0.2.0-rc.1",
        "0.2.0-rc.2",
        "0.2.1-alpha.2",
        "0.2.1-alpha.5",
        "0.2.1-rc.2"
      ]
    },
    "capability": {
      "id": "skill-hub-settings-panel",
      "kind": "ui",
      "invocation": "Open sidebar → Skills panel; GET /api/skill-hub/catalog",
      "expected": "The full local skill catalog (all roots) renders as groups; opening a row shows its detail without a restart."
    },
    "evidence": {
      "install": null,
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.7-alpha.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-alpha.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-store": ">=0.1.7-alpha.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-input-trigger": ">=0.1.7-alpha.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-alpha.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-alpha.1 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-alpha.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.1.7-alpha.1 <0.3.0-0",
    "@deepseek-ai/dsh-session-query": ">=0.1.7-alpha.1 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-alpha.1 <0.3.0-0",
    "@deepseek-ai/dsh-skill": ">=0.1.7-alpha.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.2",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "immer": "^10.2.0",
    "lightningcss": "1.32.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "zustand": "~4.4.7",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tool-todo": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-title": "0.2.2-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.2-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/*.md"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "skill",
    "skills",
    "skill-manager",
    "agent-skills",
    "skill-hub"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json && tsc -p tsconfig.tests.json",
    "test": "node scripts/check.mjs test",
    "build:runtime": "node scripts/build-runtime.mjs",
    "check:dist": "node scripts/check.mjs dist",
    "check": "node scripts/check.mjs all"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iBobbyTS/dsh-custom-instruction-manager.git"
  },
  "bugs": {
    "url": "https://github.com/iBobbyTS/dsh-custom-instruction-manager/issues"
  },
  "homepage": "https://github.com/iBobbyTS/dsh-custom-instruction-manager",
  "packageManager": "pnpm@10.28.2"
}
